# CareerMap AI - Backend Environment Configuration

# Application
APP_NAME="CareerMap AI"
APP_VERSION="1.0.0"
DEBUG=True
ENVIRONMENT="development"
HOST="0.0.0.0"
PORT=8000

# Database
# PostgreSQL with pgvector (production):
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/careermap"
# DATABASE_URL_SYNC="postgresql://postgres:postgres@localhost:5432/careermap"
# SQLite (zero-setup local development):
DATABASE_URL="sqlite+aiosqlite:///./careermap.db"
DATABASE_URL_SYNC="sqlite:///./careermap.db"

# Redis Cache
REDIS_URL="redis://localhost:6379/0"

# JWT Authentication
SECRET_KEY="replace-with-a-random-32-byte-hex-string-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Google Gemini API
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
GEMINI_EMBEDDING_MODEL="models/text-embedding-004"
AI_REQUEST_TIMEOUT=60
AI_MAX_RETRIES=3

# Adzuna Job Search API Connector
# Free registration at: https://developer.adzuna.com/
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
ADZUNA_BASE_URL="https://api.adzuna.com/v1/api"

# File Uploads
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=".pdf,.docx"
