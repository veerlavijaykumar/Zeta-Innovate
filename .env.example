# CareerMap AI - Root Deployment Configuration Template
# Copy this file to .env and configure your variables

# Backend Settings
APP_NAME="CareerMap AI"
DEBUG=False
ENVIRONMENT="production"
SECRET_KEY="generate-a-secure-random-32-byte-hex-string"

# Database Configuration (Docker Compose default uses postgres)
DATABASE_URL="postgresql+asyncpg://postgres:postgrespassword@localhost:5432/careermap"
DATABASE_URL_SYNC="postgresql://postgres:postgrespassword@localhost:5432/careermap"
REDIS_URL="redis://localhost:6379/0"

# AI Provider Credentials (Google Gemini)
# Get your free key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Multi-Source Job Connectors (Adzuna)
# Register at: https://developer.adzuna.com/
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""

# Frontend API URL (if custom)
VITE_API_BASE_URL="/api/v1"
